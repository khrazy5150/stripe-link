{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.juniorbay.com/stripe-link/UserPreferences.schema.json",
  "title": "UserPreferences",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "tenant_id", "user_id"],
  "properties": {
    "schema_version": { "type": "string", "const": "2026-05-29" },
    "document_type": { "type": "string", "const": "user_preferences" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "enum": ["system", "light", "dark"], "default": "system" },
    "default_stripe_mode": { "type": "string", "enum": ["test", "live"], "default": "test" },
    "sidebar_collapsed": { "type": "boolean", "default": false },
    "dashboard_home": { "type": "string", "default": "dashboard" },
    "landing_pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_template_id": { "type": "string", "default": "socialite" },
        "custom_color_themes": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme_id", "name", "tokens"],
            "properties": {
              "theme_id": { "type": "string" },
              "name": { "type": "string" },
              "tokens": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/hexColor" }
              },
              "fonts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "service": {
                    "type": "string",
                    "enum": ["system", "junior-bay"],
                    "default": "system"
                  },
                  "body": { "$ref": "#/$defs/fontRole" },
                  "heading": { "$ref": "#/$defs/fontRole" },
                  "accent": { "$ref": "#/$defs/fontRole" }
                }
              },
              "created_at": { "type": "integer", "minimum": 0 },
              "updated_at": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "authoring_defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-user defaults applied while creating or editing documents. These do not mutate existing tenant/product/page documents until copied into those documents. `refund_policies` was REMOVED 2026-09-30 (plans/REFUND_POLICY.md phase 6): nothing ever read it, both user-preferences tables were empty in dev and prod, and it was the slot every product's policy falsely claimed to come from. Refund defaults are tenant-level, on TenantConfig.legal_defaults.refund_policies.",
      "properties": {
        "return_address": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instructions": { "type": "string" },
            "updated_at": { "type": "integer", "minimum": 0 }
          }
        },
        "refund_request_handling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["manual_review", "automatic_acknowledgement"], "default": "manual_review" },
            "sms_notifications": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean", "default": false },
                "phone_number": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "updated_at": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "fontRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$"
        },
        "fallback": {
          "type": "string",
          "enum": ["system", "sans-serif", "serif", "monospace"],
          "default": "system"
        }
      }
    }
  }
}
