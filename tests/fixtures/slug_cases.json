    {"desired": "",       "taken": ["offer"],                    "out": "offer-2"},
    {"desired": "solo",   "taken": [],                           "out": "solo"}
  ],
  "tokens": [
    {"in": "The Best of Your Whey Protein", "limit": 3, "out": ["best", "whey", "protein"]},
    {"in": "A Guide to the Gym",            "limit": 0, "out": ["guide", "gym"]},
    {"in": "and or the",                    "limit": 0, "out": []}
  ]
