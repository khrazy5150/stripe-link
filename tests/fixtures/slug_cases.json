    {"in": "Workout Bundle",        "out": "workout-bundle"},
    {"in": "  Tax Prep!! SVC ",     "out": "tax-prep-svc"},
    {"in": "ALL CAPS NAME",         "out": "all-caps-name"},
    {"in": "a b c d",               "out": "a-b-c-d"},
    {"in": "---",                   "out": "offer"},
    {"in": "",                      "out": "offer"},
    {"in": "Ünïcode Ünicorn",       "out": "n-code-nicorn"},
    {"in": "double  --  hyphens",   "out": "double-hyphens"},
    {"in": "trailing-",             "out": "trailing"},
    {"in": "-leading",              "out": "leading"},
    {"in": "emoji 🎉 party",        "out": "emoji-party"},
    {"in": "123 456",               "out": "123-456"}
  ],
  "unique": [
